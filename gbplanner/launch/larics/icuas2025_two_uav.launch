<?xml version="1.0"?>
<!-- ICUAS 2025: two-UAV decentralized exploration + semantic inspection on the
     LARICS uav_ros_simulation stack (drones red/blue already spawned). -->
<launch>
  <arg name="strategy" default="auction"/>   <!-- auction | role -->
  <arg name="semantic" default="false"/>
  <arg name="rviz" default="true"/>
  <arg name="red_x" default="0.0"/>  <arg name="red_y" default="0.0"/>
  <arg name="blue_x" default="0.0"/> <arg name="blue_y" default="3.0"/>
  <arg name="local_yaw_deg" default="90.0"/>  <!-- LARICS SITL local frame = world rotated +90 deg (measured) -->
  <param name="use_sim_time" value="true"/>

  <include file="$(find gbplanner)/launch/larics/robot.launch">
    <arg name="ns" value="red"/>  <arg name="peers" value="[/blue]"/>
    <arg name="spawn_x" value="$(arg red_x)"/> <arg name="spawn_y" value="$(arg red_y)"/>
    <arg name="local_yaw_deg" value="$(arg local_yaw_deg)"/>
    <arg name="semantic" value="$(arg semantic)"/>
  </include>
  <include file="$(find gbplanner)/launch/larics/robot.launch">
    <arg name="ns" value="blue"/> <arg name="peers" value="[/red]"/>
    <arg name="spawn_x" value="$(arg blue_x)"/> <arg name="spawn_y" value="$(arg blue_y)"/>
    <arg name="local_yaw_deg" value="$(arg local_yaw_deg)"/>
    <arg name="semantic" value="$(arg semantic)"/>
  </include>

  <node name="Dynamic_Auction" pkg="gbplanner" type="Dynamic_Auction" output="screen">
    <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/task_allocation.yaml"/>
    <param name="strategy" value="$(arg strategy)"/>
    <rosparam param="robots">[red, blue]</rosparam>
  </node>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="gbplanner_ui"
        args="-d $(find gbplanner)/config/rviz/rmf_obelix.rviz"/>
</launch>
