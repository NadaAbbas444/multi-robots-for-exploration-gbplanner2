<?xml version="1.0"?>
<launch>
  <!-- Common Arguments -->
  <arg name="use_sim_time" default="true"/>
  <arg name="rviz_en" default="true"/>
  <arg name="launch_prefix" default=""/>
  <arg name="visualize" default="true"/>
  <arg name="gazebo_gui_en" default="false"/>
  <arg name="sensor_name" default="primesense" />
  <arg name="explorer_1" default="red"/>
  <arg name="inspector_1" default="blue"/>
  <param name="use_sim_time" value="$(arg use_sim_time)"/>
      <node name="plots_visualizer_node" pkg="gbplanner" type="plots_visualizer_node" output="screen"/>

  <!-- Configuration for Robot "Red" -->
  <group ns="red">
    <arg name="robot_name" default="rmf_obelix"/>
    <arg name="odometry_topic" default="/red/odometry"/>
    <arg name="pointcloud_topic" default="/red/velodyne_points"/>
    
    <node name="dta_node" pkg="gbplanner" type="dta_node" output="screen">
      <param name="role" value="explorer" />
      <param name="namespace" value="red" />
    </node>

    <!-- Nodes for Red drone -->
    <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node" output="screen">
      <remap from="odometry" to="$(arg odometry_topic)" />
      <remap from="pointcloud" to="$(arg pointcloud_topic)" />
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/gbplanner_config.yaml" />
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/voxblox_sim_config.yaml" />
      <param name="pointcloud_topic" value="/red/pointcloud" />
    </node>

    <node pkg="pci_general" type="pci_general_ros_node" name="pci_general_ros_node" output="screen">
      <remap from="command/trajectory" to="/red/command/trajectory" />
      <remap from="planner_server" to="gbplanner" />
      <remap from="planner_homing_server" to="gbplanner/homing" />
      <remap from="odometry" to="$(arg odometry_topic)"/>
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/planner_control_interface_sim_config.yaml" />
    </node>
    <node name="trajectory_transformer"
          pkg="gbplanner"
          type="trajectory_transformer"
          output="screen">
        <param name="offset_x_red" value="-13.0"/>
        <param name="offset_y_red" value="10.0"/>
        <param name="offset_x_blue" value="-25.0"/>
        <param name="offset_y_blue" value="10.0"/>
    </node>

    <node name="mask_rcnn" pkg="mask_rcnn_ros" type="mask_rcnn_node_modified.py" output="log">
      <param name="~namespace" value="red"/>
      <param name="~visualization" value="$(arg visualize)" />
    </node>
    <!-- <node pkg="mask_rcnn_ros" type="object_location.py" name="semantic_depth_processor" output="screen">
      <param name="~namespace" value="red"/>
      <param name="me" value="explorer"/> 
      <param name="other_robot" value="inspector"/>
    </node> -->

    <node pkg="mask_rcnn_ros" type="object_location_modified.py" name="semantic_depth_processor" output="screen">
      <param name="~namespace" value="red"/>
      <param name="me" value="explorer"/> 
      <param name="other_robot" value="inspector"/>
    </node>

  </group>

  <!-- Configuration for Robot "Blue" -->
  <group ns="blue">
    <arg name="robot_name" default="rmf_obelix"/>
    <arg name="odometry_topic" default="/blue/odometry"/>
    <arg name="pointcloud_topic" default="/blue/velodyne_points"/>
    
    <node name="dta_node" pkg="gbplanner" type="dta_node" output="screen">
      <param name="role" value="inspector" />
      <param name="namespace" value="blue" />
    </node>

    <!-- Nodes for Blue drone -->
    <node pkg="gbplanner" type="gbplanner_node" name="gbplanner_node" output="screen">
      <remap from="odometry" to="$(arg odometry_topic)" />
      <remap from="pointcloud" to="$(arg pointcloud_topic)" />
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/gbplanner_config.yaml" />
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/voxblox_sim_config.yaml" />
      <param name="pointcloud_topic" value="/blue/pointcloud" />
    </node>

    <node pkg="pci_general" type="pci_general_ros_node" name="pci_general_ros_node" output="screen">
      <remap from="command/trajectory" to="/blue/command/trajectory" />
      <remap from="planner_server" to="gbplanner" />
      <remap from="planner_homing_server" to="gbplanner/homing" />
      <remap from="odometry" to="$(arg odometry_topic)"/>
      <rosparam command="load" file="$(find gbplanner)/config/rmf_obelix/planner_control_interface_sim_config.yaml" />
    </node>
    <node name="trajectory_transformer"
          pkg="gbplanner"
          type="trajectory_transformer"
          output="screen">
        <param name="offset_x_red" value="-13.0"/>
        <param name="offset_y_red" value="10.0"/>
        <param name="offset_x_blue" value="-25.0"/>
        <param name="offset_y_blue" value="10.0"/>
    </node>

    <!-- <node name="plots_visualizer_node" pkg="gbplanner" type="plots_visualizer_node" output="screen"/> -->
    <!-- <node name="mask_rcnn" pkg="mask_rcnn_ros" type="mask_rcnn_node.py" output="log">
      <param name="~namespace" value="blue"/>
      <param name="~visualization" value="$(arg visualize)" />
    </node> -->
    <!-- <node pkg="mask_rcnn_ros" type="object_location.py" name="semantic_depth_processor" output="screen">
      <param name="~namespace" value="blue"/>
      <param name="me" value="inspector"/> 
      <param name="other_robot" value="explorer"/>
    </node> -->

    <node pkg="mask_rcnn_ros" type="object_location_modified.py" name="semantic_depth_processor" output="screen">
      <param name="~namespace" value="blue"/>
      <param name="me" value="inspector"/> 
      <param name="other_robot" value="explorer"/>
    </node>

  </group>
  <!-- Node for frontier assignment -->
<node name="Dynamic_Auction" pkg="gbplanner" type="Dynamic_Auction" output="screen"/>

    <!-- <node name="plotting_node" pkg="gbplanner" type="plotting.py" output="screen"/>  -->
  <node pkg="rviz" type="rviz" name="gbplanner_ui" output="screen" args="-d $(find gbplanner)/config/rviz/rmf_obelix.rviz"/>
  <node name="p2p" pkg="gbplanner" type="p2p" output="screen">
    <rosparam file="$(find gbplanner)/config/rmf_obelix/frontier_assignment_config.yaml" />
  </node>
</launch>
