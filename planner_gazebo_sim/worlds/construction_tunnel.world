<?xml version="1.0"?>
<!-- Under-construction tunnel with parked vehicles for the semantic inspection
     experiments (ICUAS 2025, Sec. V-B/C). 110 m x 14 m x 9 m, side niche at
     x=82..94. Vehicles (objects of interest), ground truth:
