<launch>
  <arg name="play_bag" default="true" />
  <arg name="bag_file" default="/path/to/data.bag"/>
  <arg name="visualize" default="true" />

  <!-- Download the dataset here: https://projects.asl.ethz.ch/datasets/doku.php?id=voxblox-plusplus -->
  <include file="$(find gsm_node)/launch/vpp_pipeline.launch">
    <arg name="scene_name" value="scenenn" />
    <arg name="sensor_name" value="primesense" />
    <arg name="visualize" value="$(arg visualize)" />
  </include>

    <node name="image_sync_publisher" pkg="mask_rcnn_ros" type="sync.py" output="screen">
    </node>

        <node name="shape_to_points_publisher" pkg="mask_rcnn_ros" type="inspection.py" output="screen">
    </node>

  <!-- <node pkg="rviz" type="rviz" name="mask_rcnn_ros" output="screen" args="-d $(find mask_rcnn_ros)/rviz/mask_rcnn_ros.rviz"/> -->


</launch>
